---
layout: layouts/base.njk
title: Nyheter
---

<h1>Nyheter</h1>

{% for post in nyheter %}
  <article>
    {% if post.bilde %}
      {% image post.bilde, "Bilde til {{ post.tittel }}", "(max-width: 800px) 100vw, 800px" %}
    {% endif %}
    <h2>{{ post.tittel }}</h2>
    <p><em>{{ post.dato | datoNorsk }}</em></p>
    <p>{{ post.ingress }}</p>
    <a href="/nytt/{{ post.slug }}/">Les mer</a>
  </article>
{% endfor %}
