---
pagination:
  data: nyheter
  size: 1
  alias: post
permalink: "nytt/{{ post.slug }}/index.html"
layout: layouts/base.njk
---

<article>
  <h1>{{ post.tittel }}</h1>
  <p><em>{{ post.dato | datoNorsk }}</em></p>

  {% if post.bilde %}
    {% image post.bilde, "Bilde til {{ post.title }}", "(max-width: 900px) 100vw, 900px" %}
  {% endif %}

  <p><strong>{{ post.ingress }}</strong></p>
    <div class="nytt-body">
    {{ post.body | markdown | safe }}
    </div>
  <a href="/nytt/">← Tilbake til nyheter</a>
</article>
